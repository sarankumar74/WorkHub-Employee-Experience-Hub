rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidEmployee(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150;
    }

    // Healthcheck / Connection Test
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    // Employees Collection
    match /employees/{employeeId} {
      allow read: if true;
      allow create, update: if isValidId(employeeId) && isValidEmployee(request.resource.data);
      allow delete: if false;
    }

    // Knowledge Base Articles
    match /knowledge/{articleId} {
      allow read: if true;
      allow create, update: if isValidId(articleId);
      allow delete: if false;
    }

    // Events & Meetings
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId);
      allow delete: if false;
    }

    // Offboarding Records
    match /offboarding/{recordId} {
      allow read: if true;
      allow create, update: if isValidId(recordId);
      allow delete: if false;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }
  }
}
